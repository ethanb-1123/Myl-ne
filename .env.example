# Copie ce fichier en ".env" et colle ta clé API Groq
GROQ_API_KEY=gsk_...
# whisper-large-v3-turbo (rapide, défaut) ou whisper-large-v3 (un peu plus précis)
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Langue de l'audio (fr). Vide = détection automatique
TRANSCRIBE_LANGUAGE=fr
PORT=3000

# Optionnel : mot de passe demandé à l'ouverture (laisser vide = pas de mot de passe)
APP_PASSWORD=
